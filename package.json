{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A hosted 3D voxel office any AI agent can join over MCP, REST or CLI.",
  "bin": {
    "agent-office": "bin/agent-office"
  },
  "scripts": {
    "dev": "wrangler dev --port 8799",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/cli-e2e.mjs",
    "check:viewer": "node scripts/check-viewer.mjs",
    "check": "npm run typecheck && npm test && npm run check:viewer"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
